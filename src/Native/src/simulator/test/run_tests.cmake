# Usage: cmake -DTEST_EXE=<k230_isa_test> -DTEST_DIR=<dir with .s files> -P run_tests.cmake
file(GLOB tests "${TEST_DIR}/*.s")
list(SORT tests)
set(failed 0)
foreach(t IN LISTS tests)
    execute_process(COMMAND "${TEST_EXE}" "${t}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    message("${out}${err}")
    if(NOT rc EQUAL 0)
        math(EXPR failed "${failed}+1")
    endif()
endforeach()
list(LENGTH tests total)
if(failed)
    message(FATAL_ERROR "${failed} of ${total} test(s) failed")
endif()
message("All ${total} test(s) passed")
